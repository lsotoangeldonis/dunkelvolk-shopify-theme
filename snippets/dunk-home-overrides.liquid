{%- comment -%}
  Home-page-only overrides:
    - Forces the Dunk header to overlay the hero (transparent at top, fixed white on scroll)
    - Hero slideshow at ~80vh desktop / 75vh mobile so the next section peeks through
    - Cancels theme.scss padding-top on .main-content / #PageContainer that would push the hero down
    - Hero text styling (right-aligned, white over photo, button)

  Loaded conditionally from theme.liquid only when request.page_type == 'index'.
{%- endcomment -%}
<style id="dunk-home-overrides">
  /* Hero: ~80vh desktop so the next section peeks through */
  body.template-index .slideshow-wrapper-desktop.main-banner .slideshow,
  body.template-index .slideshow-wrapper-desktop .slideshow,
  body.template-index .shopify-section.slideshow-thebox--section,
  body.template-index .shopify-section.slideshow-thebox--section > div,
  body.template-index .shopify-section.slideshow-thebox--section .slideshow-wrapper {
    height: 80vh !important;
    max-height: none !important;
    min-height: 540px;
  }
  body.template-index .slideshow-wrapper-desktop.main-banner .slideshow__image,
  body.template-index .slideshow-wrapper-desktop.main-banner .slideshow__slide,
  body.template-index .slideshow .slick-list,
  body.template-index .slideshow .slick-track,
  body.template-index .slideshow .slick-slide > div {
    height: 100% !important;
  }
  body.template-index .slideshow-wrapper-desktop.main-banner .slideshow__image img,
  body.template-index .slideshow-wrapper-desktop.main-banner picture img,
  body.template-index .slideshow__slide picture,
  body.template-index .slideshow__slide picture img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center;
  }

  /* Cancel theme.scss padding-top so the hero starts at viewport top */
  body.template-index .main-content,
  body.template-index #PageContainer {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }
  body.template-index .shopify-section.slideshow-thebox--section { margin-top: 0; }

  /* Header overlay forced on home (transparent at top, white+sticky on scroll) */
  body.template-index .dunk-header-wrapper {
    position: absolute !important;
    top: 0; left: 0; right: 0;
    background: transparent !important;
    color: #111 !important;
    z-index: 100;
  }
  body.template-index .dunk-header-wrapper--solid {
    position: fixed !important;
    background: #fff !important;
    box-shadow: 0 1px 0 rgba(0,0,0,.08);
  }

  /* Hero text — right-aligned, heading not bold, button rounded */
  body.template-index .slideshow__title,
  body.template-index .slideshow__subtitle {
    color: #fff !important;
    text-shadow: 0 2px 12px rgba(0,0,0,.25);
    font-family: var(--font-body) !important;
  }
  body.template-index .slideshow__title {
    font-size: clamp(22px, 2.4vw, 38px) !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    max-width: 480px;
    margin: 0 0 6px !important;
    letter-spacing: -0.005em;
  }
  body.template-index .slideshow__subtitle {
    font-weight: 400 !important;
    font-size: clamp(12px, 1vw, 15px) !important;
    line-height: 1.4 !important;
  }
  body.template-index .slideshow__text-content--vertical-center.text-right {
    text-align: right;
    padding-right: 4vw;
  }
  body.template-index .slideshow__text-content-list { display: block; }
  body.template-index .slideshow__btn-wrapper { margin-top: 16px; }
  body.template-index .slideshow__btn {
    background: #fff !important;
    color: #111 !important;
    border: 0 !important;
    min-height: 0 !important;
    padding: 8px 22px !important;
    border-radius: 4px;
    font-family: var(--font-body) !important;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0;
    line-height: 1.3 !important;
    text-transform: none !important;
  }
  body.template-index .slideshow__btn:hover { background: #f1f1f1 !important; }

  @media (max-width: 749px) {
    body.template-index .slideshow-wrapper-desktop.main-banner .slideshow,
    body.template-index .slideshow-wrapper-desktop .slideshow,
    body.template-index .shopify-section.slideshow-thebox--section,
    body.template-index .shopify-section.slideshow-thebox--section > div,
    body.template-index .shopify-section.slideshow-thebox--section .slideshow-wrapper {
      height: 75vh !important;
      min-height: 480px;
    }
    body.template-index .slideshow__title { max-width: 100%; padding: 0 16px; font-size: 20px !important; }
    body.template-index .slideshow__text-content--vertical-center.text-right { padding-right: 16px; }
  }
</style>
