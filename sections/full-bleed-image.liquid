{%- assign component_class = 'full-bleed-image__' | append: section.id -%}

<style>
  .{{ component_class }} {
    width: 100%;
    margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;
  }
  .{{ component_class }}__media {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    background: #1a1a1a;
  }
  .{{ component_class }}__media img,
  .{{ component_class }}__media video {
    width: 100%;
    height: auto;
    display: block;
  }
  .{{ component_class }}__placeholder {
    width: 100%;
    aspect-ratio: 16 / 7;
    background: linear-gradient(135deg, #d8d8d8 0%, #f4f4f4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6a6a6a;
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .{{ component_class }}__video--mobile { display: none; }
  @media (max-width: 749px) {
    .{{ component_class }} {
      margin: {{ section.settings.margin_top_mobile }}px 0 {{ section.settings.margin_bottom_mobile }}px;
    }
    .{{ component_class }}__placeholder { aspect-ratio: 4 / 5; }
    .{{ component_class }}__video--desktop { display: none; }
    .{{ component_class }}__video--mobile { display: block; }
  }
</style>

<section class="{{ component_class }}" data-section-id="{{ section.id }}" data-section-type="full-bleed-image">
  {%- comment -%} Resolve video source priority: video_url > video_filename (asset) {%- endcomment -%}
  {%- assign video_desktop_src = '' -%}
  {%- assign video_mobile_src = '' -%}
  {%- if section.settings.video_url != blank -%}
    {%- assign video_desktop_src = section.settings.video_url -%}
  {%- elsif section.settings.video_filename != blank -%}
    {%- assign video_desktop_src = section.settings.video_filename | asset_url -%}
  {%- endif -%}
  {%- if section.settings.video_url_mobile != blank -%}
    {%- assign video_mobile_src = section.settings.video_url_mobile -%}
  {%- elsif section.settings.video_filename_mobile != blank -%}
    {%- assign video_mobile_src = section.settings.video_filename_mobile | asset_url -%}
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    <a class="{{ component_class }}__media" href="{{ section.settings.link }}">
  {%- else -%}
    <div class="{{ component_class }}__media">
  {%- endif -%}
    {%- if video_desktop_src != '' -%}
      {%- if video_mobile_src != '' -%}
        <video class="{{ component_class }}__video--desktop" src="{{ video_desktop_src }}" autoplay loop muted playsinline></video>
        <video class="{{ component_class }}__video--mobile" src="{{ video_mobile_src }}" autoplay loop muted playsinline></video>
      {%- else -%}
        <video src="{{ video_desktop_src }}" autoplay loop muted playsinline></video>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      {%- assign desktop_img = section.settings.image -%}
      {%- assign mobile_img = section.settings.image_mobile | default: desktop_img -%}
      <picture>
        <source media="(min-width: 750px)" srcset="{{ desktop_img | img_url: '2000x' }} 1x, {{ desktop_img | img_url: '3200x' }} 2x">
        <source media="(max-width: 749px)" srcset="{{ mobile_img | img_url: '900x' }} 1x, {{ mobile_img | img_url: '1800x' }} 2x">
        <img src="{{ desktop_img | img_url: '2000x' }}" alt="{{ desktop_img.alt | escape }}" loading="lazy">
      </picture>
    {%- else -%}
      <div class="{{ component_class }}__placeholder">
        {{ section.settings.placeholder_text | default: 'Video o imagen full-width' }}
      </div>
    {%- endif -%}
  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": {
    "en": "Full-bleed image",
    "es": "Imagen full-width"
  },
  "class": "index-section index-section--flush full-bleed-image",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": { "en": "Video URL (desktop)", "es": "URL del video (desktop)" },
      "info": { "en": "External video URL (e.g. Shopify CDN .mp4). Takes priority over asset filename and image.", "es": "URL externa (ej. .mp4 en Shopify CDN). Tiene prioridad sobre el filename y la imagen." }
    },
    {
      "type": "url",
      "id": "video_url_mobile",
      "label": { "en": "Video URL (mobile)", "es": "URL del video (mobile)" },
      "info": { "en": "Optional. Falls back to desktop URL.", "es": "Opcional. Usa la URL desktop si está vacío." }
    },
    {
      "type": "text",
      "id": "video_filename",
      "label": { "en": "Video filename in assets/ (desktop)", "es": "Filename del video en assets/ (desktop)" },
      "info": { "en": "Alternative to Video URL. e.g. pajaro.mp4 — file in /assets/.", "es": "Alternativa a Video URL. ej. pajaro.mp4 — archivo en /assets/." }
    },
    {
      "type": "text",
      "id": "video_filename_mobile",
      "label": { "en": "Video filename in assets/ (mobile)", "es": "Filename del video en assets/ (mobile)" },
      "info": { "en": "Optional. Falls back to desktop filename.", "es": "Opcional. Usa el desktop si está vacío." }
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": { "en": "Image fallback (desktop)", "es": "Imagen fallback (desktop)" }
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": { "en": "Image (mobile)", "es": "Imagen (mobile)" }
    },
    {
      "type": "url",
      "id": "link",
      "label": { "en": "Link (optional)", "es": "Enlace (opcional)" }
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": { "en": "Placeholder text", "es": "Texto del placeholder" },
      "default": "Imagen full-width · sube tu foto"
    },
    {
      "type": "header",
      "content": { "en": "Spacing", "es": "Espaciado" }
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": { "en": "Top margin (desktop)", "es": "Margen superior (desktop)" },
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": { "en": "Bottom margin (desktop)", "es": "Margen inferior (desktop)" },
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": { "en": "Top margin (mobile)", "es": "Margen superior (mobile)" },
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": { "en": "Bottom margin (mobile)", "es": "Margen inferior (mobile)" },
      "default": 0
    }
  ],
  "presets": [
    {
      "name": { "en": "Full-bleed image", "es": "Imagen full-width" },
      "category": { "en": "Dunkelvolk", "es": "Dunkelvolk" }
    }
  ]
}
{% endschema %}
