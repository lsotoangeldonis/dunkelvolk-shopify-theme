{%- assign component_class = 'logo-banner-dunk__' | append: section.id -%}

<style>
  .{{ component_class }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  .{{ component_class }}__logo {
    display: inline-block;
    max-width: {{ section.settings.logo_max_width }}px;
    width: 100%;
    height: auto;
  }
  .{{ component_class }}__logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .{{ component_class }}__placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.logo_max_width }}px;
    max-width: 100%;
    height: 80px;
    background: #f4f4f4;
    color: #888;
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  @media (max-width: 749px) {
    .{{ component_class }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    .{{ component_class }}__logo { max-width: {{ section.settings.logo_max_width_mobile }}px; }
  }
</style>

<section class="{{ component_class }}" data-section-id="{{ section.id }}" data-section-type="logo-banner-dunk">
  {%- if section.settings.link != blank -%}
    <a class="{{ component_class }}__logo" href="{{ section.settings.link }}" aria-label="{{ shop.name | escape }}">
  {%- else -%}
    <div class="{{ component_class }}__logo">
  {%- endif -%}
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | img_url: '600x' }}"
           srcset="{{ section.settings.logo | img_url: '600x' }} 1x, {{ section.settings.logo | img_url: '1200x' }} 2x"
           alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
           loading="lazy">
    {%- else -%}
      <div class="{{ component_class }}__placeholder">Logo placeholder</div>
    {%- endif -%}
  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": {
    "en": "Logo banner",
    "es": "Banner de logo"
  },
  "class": "index-section index-section--flush logo-banner-dunk",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": { "en": "Logo image", "es": "Imagen del logo" }
    },
    {
      "type": "url",
      "id": "link",
      "label": { "en": "Link (optional)", "es": "Enlace (opcional)" }
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": { "en": "Background color", "es": "Color de fondo" },
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 80, "max": 600, "step": 10, "unit": "px",
      "label": { "en": "Logo max width (desktop)", "es": "Ancho máximo (desktop)" },
      "default": 280
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "min": 60, "max": 400, "step": 10, "unit": "px",
      "label": { "en": "Logo max width (mobile)", "es": "Ancho máximo (mobile)" },
      "default": 160
    },
    {
      "type": "header",
      "content": { "en": "Spacing", "es": "Espaciado" }
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "label": { "en": "Top padding (desktop)", "es": "Padding superior (desktop)" },
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "label": { "en": "Bottom padding (desktop)", "es": "Padding inferior (desktop)" },
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "label": { "en": "Top padding (mobile)", "es": "Padding superior (mobile)" },
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "label": { "en": "Bottom padding (mobile)", "es": "Padding inferior (mobile)" },
      "default": 36
    }
  ],
  "presets": [
    {
      "name": { "en": "Logo banner", "es": "Banner de logo" },
      "category": { "en": "Dunkelvolk", "es": "Dunkelvolk" }
    }
  ]
}
{% endschema %}
