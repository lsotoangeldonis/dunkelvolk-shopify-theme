{%- assign component_class = 'pima-journey-quote-split__' | append: section.id -%}

<style>
  .{{ component_class }} {
    background: #fff;
  }

  .{{ component_class }}__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
  }

  /* Foto retrato izquierda — ocupa toda la altura del grid row */
  .{{ component_class }}__portrait {
    position: relative;
    overflow: hidden;
  }

  .{{ component_class }}__portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Columna derecha: cita + foto secundaria */
  .{{ component_class }}__content {
    display: flex;
    flex-direction: column;
    padding: 64px 56px;
    background: #fff;
  }

  .{{ component_class }}__quote {
    border-left: 3px solid #111;
    padding-left: 22px;
    margin: 0;
  }

  .{{ component_class }}__quote p {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(24px, 2.4vw, 36px);
    font-weight: 800;
    color: #111;
    line-height: 1.22;
    margin: 0;
  }

  /* Foto secundaria: empujada al fondo, alineada a la derecha, ~65% de la columna */
  .{{ component_class }}__secondary {
    margin-top: auto;
    padding-top: 48px;
    width: 65%;
    align-self: flex-end;
  }

  .{{ component_class }}__secondary img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 749px) {
    .{{ component_class }}__inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    /* Retrato oculto en mobile */
    .{{ component_class }}__portrait {
      display: none;
    }

    .{{ component_class }}__content {
      padding: 40px 24px;
    }

    .{{ component_class }}__secondary {
      width: 100%;
      align-self: stretch;
      padding-top: 28px;
    }
  }
</style>

<section class="{{ component_class }}">
  <div class="{{ component_class }}__inner">

    {%- assign portrait_src = '' -%}
    {%- if section.settings.portrait_filename != blank -%}
      {%- assign portrait_src = section.settings.portrait_filename | asset_url -%}
    {%- elsif section.settings.portrait_image != blank -%}
      {%- assign portrait_src = section.settings.portrait_image | img_url: '900x' -%}
    {%- endif -%}
    <div class="{{ component_class }}__portrait">
      {%- if portrait_src != blank -%}
        <img src="{{ portrait_src }}" alt="" loading="lazy">
      {%- endif -%}
    </div>

    <div class="{{ component_class }}__content">
      {%- if section.settings.quote != blank -%}
        <blockquote class="{{ component_class }}__quote">
          <p>{{ section.settings.quote | escape }}</p>
        </blockquote>
      {%- endif -%}

      {%- assign secondary_src = '' -%}
      {%- if section.settings.secondary_filename != blank -%}
        {%- assign secondary_src = section.settings.secondary_filename | asset_url -%}
      {%- elsif section.settings.secondary_image != blank -%}
        {%- assign secondary_src = section.settings.secondary_image | img_url: '800x' -%}
      {%- endif -%}
      {%- if secondary_src != blank -%}
        <div class="{{ component_class }}__secondary">
          <img src="{{ secondary_src }}" alt="" loading="lazy">
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pima Journey: Quote Split",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Cita",
      "default": "“Pensé que estaba documentando un viaje, pero en realidad estaba entendiendo el mío.”"
    },
    {
      "type": "text",
      "id": "portrait_filename",
      "label": "Foto retrato izquierda (assets/)",
      "info": "Ej: mirahorizontemobile.png — se oculta en mobile",
      "default": "mirahorizontemobile.png"
    },
    {
      "type": "image_picker",
      "id": "portrait_image",
      "label": "Foto retrato izquierda (Shopify Files)"
    },
    {
      "type": "text",
      "id": "secondary_filename",
      "label": "Foto secundaria (assets/)",
      "info": "Ej: camionjour.png — aparece abajo-derecha en desktop, full-width en mobile",
      "default": "camionjour.png"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Foto secundaria (Shopify Files)"
    }
  ],
  "presets": [
    {
      "name": "Pima Journey: Quote Split",
      "settings": {
        "portrait_filename": "mirahorizontemobile.png",
        "secondary_filename": "camionjour.png"
      }
    }
  ]
}
{% endschema %}
