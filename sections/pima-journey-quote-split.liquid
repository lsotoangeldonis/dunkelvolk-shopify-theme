{%- assign component_class = 'pima-journey-quote-split__' | append: section.id -%}
{%- assign layout = section.settings.layout | default: 'portrait-left' -%}

<style>
  .{{ component_class }} {
    background: #fff;
    padding: 80px;
  }

  .{{ component_class }}__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    /* No min-height: rows auto-size to portrait's natural height */
  }

  /* portrait-right mode: swap visual order on desktop */
  .{{ component_class }}--portrait-right .{{ component_class }}__portrait { order: 2; }
  .{{ component_class }}--portrait-right .{{ component_class }}__content { order: 1; }

  /* Foto retrato — se muestra COMPLETA con su aspect ratio natural, sin recortes */
  .{{ component_class }}__portrait {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .{{ component_class }}__portrait img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Columna content: cita arriba + foto auxiliar con espacio razonable (no push al fondo) */
  .{{ component_class }}__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 140px;
    padding: 140px 56px 32px;
    background: #fff;
  }

  .{{ component_class }}__quote {
    border-left: 3px solid #111;
    padding-left: 22px;
    margin: 0;
    max-width: 610px;
    text-align: left;
  }
  .{{ component_class }}--portrait-right .{{ component_class }}__quote { margin-left: 0; }

  .{{ component_class }}__quote p {
    font-family: var(--font-body, sans-serif);
    font-size: 42px;
    font-weight: 800;
    color: #111;
    line-height: 1.15;
    margin: 0;
    text-align: left;
  }

  /* Foto auxiliar: 60% del ancho, centrada horizontalmente, con margen superior 60px */
  .{{ component_class }}__secondary {
    margin-top: 60px;
    padding-top: 0;
    width: 70%;
    align-self: center;
  }

  .{{ component_class }}__secondary img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 749px) {
    .{{ component_class }}__inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    /* Mobile order: portrait FIRST (above the quote), then content. Hold for both layouts. */
    .{{ component_class }}__portrait,
    .{{ component_class }}--portrait-right .{{ component_class }}__portrait { order: 1; display: block; }
    .{{ component_class }}__content,
    .{{ component_class }}--portrait-right .{{ component_class }}__content { order: 2; }

    /* Portrait visible on mobile in normal flow (height auto) */
    .{{ component_class }}__portrait {
      position: relative;
      min-height: 460px;
    }

    .{{ component_class }}__content {
      padding: 40px 24px;
    }

    .{{ component_class }}__secondary {
      width: 100%;
      align-self: stretch;
      padding-top: 28px;
    }
  }
</style>

<section class="{{ component_class }} {{ component_class }}--{{ layout }}">
  <div class="{{ component_class }}__inner">

    {%- comment -%} Portrait: prefer mobile asset on small screens via <picture> {%- endcomment -%}
    {%- assign portrait_desktop = '' -%}
    {%- if section.settings.portrait_filename != blank -%}
      {%- assign portrait_desktop = section.settings.portrait_filename | asset_url -%}
    {%- elsif section.settings.portrait_image != blank -%}
      {%- assign portrait_desktop = section.settings.portrait_image | img_url: '1200x' -%}
    {%- endif -%}
    {%- assign portrait_mobile = '' -%}
    {%- if section.settings.portrait_filename_mobile != blank -%}
      {%- assign portrait_mobile = section.settings.portrait_filename_mobile | asset_url -%}
    {%- elsif section.settings.portrait_image_mobile != blank -%}
      {%- assign portrait_mobile = section.settings.portrait_image_mobile | img_url: '900x' -%}
    {%- else -%}
      {%- assign portrait_mobile = portrait_desktop -%}
    {%- endif -%}

    <div class="{{ component_class }}__portrait">
      {%- if portrait_desktop != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ portrait_mobile }}">
          <img src="{{ portrait_desktop }}" alt="" loading="lazy">
        </picture>
      {%- endif -%}
    </div>

    <div class="{{ component_class }}__content">
      {%- if section.settings.quote != blank -%}
        <blockquote class="{{ component_class }}__quote">
          <p>{{ section.settings.quote | escape }}</p>
        </blockquote>
      {%- endif -%}

      {%- comment -%} Secondary aux photo with mobile variant {%- endcomment -%}
      {%- assign secondary_desktop = '' -%}
      {%- if section.settings.secondary_filename != blank -%}
        {%- assign secondary_desktop = section.settings.secondary_filename | asset_url -%}
      {%- elsif section.settings.secondary_image != blank -%}
        {%- assign secondary_desktop = section.settings.secondary_image | img_url: '1000x' -%}
      {%- endif -%}
      {%- assign secondary_mobile = '' -%}
      {%- if section.settings.secondary_filename_mobile != blank -%}
        {%- assign secondary_mobile = section.settings.secondary_filename_mobile | asset_url -%}
      {%- elsif section.settings.secondary_image_mobile != blank -%}
        {%- assign secondary_mobile = section.settings.secondary_image_mobile | img_url: '800x' -%}
      {%- else -%}
        {%- assign secondary_mobile = secondary_desktop -%}
      {%- endif -%}
      {%- if secondary_desktop != blank -%}
        <div class="{{ component_class }}__secondary">
          <picture>
            <source media="(max-width: 749px)" srcset="{{ secondary_mobile }}">
            <img src="{{ secondary_desktop }}" alt="" loading="lazy">
          </picture>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pima Journey: Quote Split",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout (desktop)",
      "options": [
        { "value": "portrait-left",  "label": "Retrato izquierda · cita derecha (slide 14)" },
        { "value": "portrait-right", "label": "Cita izquierda · retrato derecha (slide 17)" }
      ],
      "default": "portrait-left"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Cita",
      "default": "“Pensé que estaba documentando un viaje, pero en realidad estaba entendiendo el mío.”"
    },
    {
      "type": "header",
      "content": "Foto retrato (lado completo)"
    },
    {
      "type": "text",
      "id": "portrait_filename",
      "label": "Foto retrato · desktop (assets/)"
    },
    {
      "type": "image_picker",
      "id": "portrait_image",
      "label": "Foto retrato · desktop (Shopify Files)"
    },
    {
      "type": "text",
      "id": "portrait_filename_mobile",
      "label": "Foto retrato · mobile (assets/)"
    },
    {
      "type": "image_picker",
      "id": "portrait_image_mobile",
      "label": "Foto retrato · mobile (Shopify Files)"
    },
    {
      "type": "header",
      "content": "Foto auxiliar (abajo)"
    },
    {
      "type": "text",
      "id": "secondary_filename",
      "label": "Foto auxiliar · desktop (assets/)"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Foto auxiliar · desktop (Shopify Files)"
    },
    {
      "type": "text",
      "id": "secondary_filename_mobile",
      "label": "Foto auxiliar · mobile (assets/)"
    },
    {
      "type": "image_picker",
      "id": "secondary_image_mobile",
      "label": "Foto auxiliar · mobile (Shopify Files)"
    }
  ],
  "presets": [
    {
      "name": "Pima Journey: Quote Split",
      "settings": {
        "layout": "portrait-left"
      }
    }
  ]
}
{% endschema %}
