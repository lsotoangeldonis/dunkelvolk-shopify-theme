{%- comment -%}
  About Us — Text block (heading + body) above a centered brand logo + wordmark.
  Used for "EXPLORING QUALITY".
{%- endcomment -%}
{%- assign component_class = 'aboutus-quality-logo__' | append: section.id -%}
{%- assign text_align = section.settings.text_align | default: 'justify' -%}

{%- assign logo_src = '' -%}
{%- if section.settings.logo_filename != blank -%}
  {%- assign logo_src = section.settings.logo_filename | asset_url -%}
{%- elsif section.settings.logo != blank -%}
  {%- assign logo_src = section.settings.logo | img_url: '400x' -%}
{%- endif -%}

<style>
  .{{ component_class }}__text {
    padding: 64px 48px 24px;
    max-width: 1600px;
    margin: 0 auto;
    text-align: {{ text_align }};
  }
  .{{ component_class }}__heading {
    font-family: var(--font-body, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 22px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-size: clamp(30px, 4.6vw, 52px);
    text-align: left;
  }
  .{{ component_class }}__body {
    font-family: var(--font-body, sans-serif);
    color: #111;
    font-size: clamp(16px, 1.45vw, 21px);
    font-weight: 400;
    line-height: 1.55;
  }
  .{{ component_class }}__body p { margin: 0 0 0.4em; }
  .{{ component_class }}__body p:last-child { margin-bottom: 0; }

  .{{ component_class }}__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding: 56px 24px 80px;
  }
  .{{ component_class }}__logo {
    display: block;
    width: clamp(120px, 14vw, 190px);
    height: auto;
  }
  .{{ component_class }}__wordmark {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    color: #111;
    letter-spacing: 0.18em;
    line-height: 1;
    font-size: clamp(28px, 4vw, 52px);
    margin: 0;
    padding-left: 0.18em; /* compensate trailing letter-spacing for optical centering */
  }

  @media (max-width: 749px) {
    .{{ component_class }}__text { padding: 40px 24px 16px; }
    .{{ component_class }}__heading { font-size: clamp(26px, 8vw, 40px); margin-bottom: 16px; }
    .{{ component_class }}__body { font-size: 16px; }
    .{{ component_class }}__brand { padding: 40px 24px 56px; gap: 18px; }
    .{{ component_class }}__wordmark { font-size: clamp(24px, 8vw, 38px); }
  }
</style>

<section class="{{ component_class }}">
  {%- if section.settings.heading != blank or section.settings.body != blank -%}
    <div class="{{ component_class }}__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ component_class }}__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="{{ component_class }}__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="{{ component_class }}__brand">
    {%- if logo_src != '' -%}
      <img class="{{ component_class }}__logo" src="{{ logo_src }}" alt="Dunkelvolk" loading="lazy">
    {%- endif -%}
    {%- if section.settings.wordmark != blank -%}
      <p class="{{ component_class }}__wordmark">{{ section.settings.wordmark }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Us: Texto + logo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "justify", "label": "Justificado" }
      ],
      "default": "justify"
    },
    {
      "type": "header",
      "content": "Logo de marca"
    },
    {
      "type": "text",
      "id": "logo_filename",
      "label": "Logo (assets/)",
      "info": "Ej: dunk-journey-logo-circle.jpg"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (Shopify Files)"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Texto del wordmark",
      "default": "DUNKELVOLK"
    }
  ],
  "presets": [
    {
      "name": "About Us: Texto + logo"
    }
  ]
}
{% endschema %}
