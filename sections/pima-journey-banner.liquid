{%- assign component_class = 'pima-journey-banner__' | append: section.id -%}
{%- assign caption_position = section.settings.caption_position | default: 'bottom-left' -%}
{%- assign caption_style = section.settings.caption_style | default: 'display' -%}

<style>
  /* Loaded only on pages with this section. Kill ALL possible sources of top gap
     above the banner. Using ID selectors (#MainContent, #PageContainer) so we beat
     any class-based rule in theme.scss regardless of specificity. */
  html body #PageContainer,
  html body #MainContent,
  html body .page-container,
  html body .main-content {
    padding-top: 0 !important;
    padding-block-start: 0 !important;
    margin-top: 0 !important;
    margin-block-start: 0 !important;
  }
  /* The first shopify-section wrapper inside main also gets zeroed */
  html body #MainContent > .shopify-section:first-child,
  html body .main-content > .shopify-section:first-child,
  html body #PageContainer > .shopify-section:first-child {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }
  /* Neutralize the section's own wrapper too */
  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .{{ component_class }} {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
  }

  .{{ component_class }}__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .{{ component_class }}__content {
    position: relative;
    z-index: 2;
    padding: 56px 48px;
    width: 100%;
    display: flex;
  }

  .{{ component_class }}--bottom-left  .{{ component_class }}__content { align-items: flex-end;   justify-content: flex-start; }
  .{{ component_class }}--bottom-right .{{ component_class }}__content { align-items: flex-end;   justify-content: flex-end; }
  .{{ component_class }}--top-left     .{{ component_class }}__content { align-items: flex-start; justify-content: flex-start; }
  .{{ component_class }}--top-right    .{{ component_class }}__content { align-items: flex-start; justify-content: flex-end; }

  .{{ component_class }}__title {
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.22);
  }

  /* Display style: FatFrank Heavy, mega size, uppercase */
  .{{ component_class }}--style-display .{{ component_class }}__title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(42px, 5.5vw, 80px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* Body style: Avenir Heavy, medium size, mixed case */
  .{{ component_class }}--style-body .{{ component_class }}__title {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(24px, 2.6vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    max-width: 520px;
  }

  /* Text alignment matches anchor */
  .{{ component_class }}--bottom-right .{{ component_class }}__title,
  .{{ component_class }}--top-right    .{{ component_class }}__title { text-align: right; }

  @media (max-width: 749px) {
    .{{ component_class }} {
      min-height: 100vh;
    }
    .{{ component_class }}__content {
      padding: 40px 24px;
    }
    .{{ component_class }}--style-display .{{ component_class }}__title {
      font-size: clamp(32px, 9vw, 52px);
    }
    .{{ component_class }}--style-body .{{ component_class }}__title {
      font-size: clamp(18px, 5.5vw, 28px);
    }
  }
</style>

<div class="{{ component_class }} {{ component_class }}--{{ caption_position }} {{ component_class }}--style-{{ caption_style }}">
  {%- assign mobile_src = '' -%}
  {%- if section.settings.asset_filename_mobile != blank -%}
    {%- assign mobile_src = section.settings.asset_filename_mobile | asset_url -%}
  {%- elsif section.settings.image_mobile != blank -%}
    {%- assign mobile_src = section.settings.image_mobile | img_url: '800x' -%}
  {%- endif -%}

  {%- assign desktop_src = '' -%}
  {%- if section.settings.asset_filename != blank -%}
    {%- assign desktop_src = section.settings.asset_filename | asset_url -%}
  {%- elsif section.settings.image != blank -%}
    {%- assign desktop_src = section.settings.image | img_url: '2000x' -%}
  {%- endif -%}

  <picture>
    {%- if mobile_src != blank -%}
      <source media="(max-width: 749px)" srcset="{{ mobile_src }}">
    {%- endif -%}
    {%- if desktop_src != blank -%}
      <img
        class="{{ component_class }}__image"
        src="{{ desktop_src }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </picture>

  {%- if section.settings.heading != blank -%}
    <div class="{{ component_class }}__content">
      <h1 class="{{ component_class }}__title">{{ section.settings.heading }}</h1>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Pima Journey: Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Texto del banner (vacío = sin caption)"
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Posición del caption",
      "options": [
        { "value": "bottom-left",  "label": "Abajo izquierda" },
        { "value": "bottom-right", "label": "Abajo derecha" },
        { "value": "top-left",     "label": "Arriba izquierda" },
        { "value": "top-right",    "label": "Arriba derecha" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "caption_style",
      "label": "Estilo del caption",
      "options": [
        { "value": "display", "label": "Display (FatFrank, mega, uppercase) — slide 11/EXPLORE.CONNECT" },
        { "value": "body",    "label": "Body (Avenir, medio, mixed case) — slide 16/For those who follow…" }
      ],
      "default": "display"
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "text",
      "id": "asset_filename",
      "label": "Imagen desktop (assets/)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen desktop (Shopify Files)"
    },
    {
      "type": "text",
      "id": "asset_filename_mobile",
      "label": "Imagen mobile (assets/)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen mobile (Shopify Files)"
    }
  ],
  "presets": [
    {
      "name": "Pima Journey: Banner",
      "settings": {
        "caption_position": "bottom-left",
        "caption_style": "display"
      }
    }
  ]
}
{% endschema %}
