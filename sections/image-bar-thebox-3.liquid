<div class="{{ section.id }} image-bar-thebox {% if section.settings.slider_mode %} slider-enabled{% endif %}">
  <article class="r-ups swiper--enabled">
    <div class="r-3ups-titles-below">
      {% if section.settings.title != blank %}<h2 class="swiper-title">{{ section.settings.title }}</h3>{% endif %}
      <div class="swiper-container slideshow-wrapper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
          	<div class="r-3ups-description swiper-slide js" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">
                {% endif %}
				{% if section.settings.cta_label_top != blank %}
                    {% if block.settings.cta_label != blank %}
                      <h2 class="h2-legend">
						{{ block.settings.cta_label }}
                      </h2>
                	{% endif %}
                {% endif %}
                <picture>
                  <source srcset="{{ block.settings.image | img_url: '575x575' }} 575w 575h" media="(min-width: 725px)">
                  <img loading="lazy" srcset="{{ block.settings.image_mobile | img_url: 'master' }}" alt="{{ block.settings.cta_label }}">
                </picture>
                    <div class="r-3ups-description-wrapper">
                      {% unless section.settings.cta_label_top != blank %}
                        {% if block.settings.cta_label != blank %}
                          <h2 class="h2-legend">
                            {% if block.settings.link != blank %}
                                <a href="{{ block.settings.link }}">
                             {% endif %}
                                  {{ block.settings.cta_label }}
                             {% if block.settings.link != blank %}
                                </a>
                             {% endif %}
                            </a>
                          </h2>
                        {% endif %}
                      {% endunless %}
					  {% if block.settings.cta_description != blank %}
                      	<p>{{ block.settings.cta_description }}</p>
					  {% endif %}
					  {% if block.settings.button_text != blank %}
                        <div class="r-linkcta href-js margin-top" data-href="https://www.dcshoes.com/josh-kalis-collection/#?intcmp=dc_542092">
                          {{ block.settings.button_text }}
                        </div>
					  {% endif %}
                    </div>
                    {% if block.settings.link != blank %}
                      </a>
                   {% endif %}
              </div>
           {% endfor %}
        </div>
      	<span class="slideshow__arrow slideshow__arrow-left side-arrow side-arrow-left square">
        {% include 'icon-chevron-left-alt' %}
    	</span>
        <div class="swiper-wrapper mobile {% if section.settings.slider_mode %} slider-thebox{% endif %}" data-side-arrows="true">
          {% for block in section.blocks %}
          	<div class="r-3ups-description swiper-slide js" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">
                {% endif %}
                <picture>
                  <source srcset="{{ block.settings.image | img_url: '575x575' }} 575w 575h" media="(min-width: 725px)">
                  <img loading="lazy" srcset="{{ block.settings.image_mobile | img_url: 'master' }}" alt="{{ block.settings.cta_label }}">
                </picture>
                    <div class="r-3ups-description-wrapper">
                      {% if block.settings.cta_label != blank %}
                      	<h2>
                          {% if block.settings.link != blank %}
                              <a href="{{ block.settings.link }}">
                           {% endif %}
                            	{{ block.settings.cta_label }}
                           {% if block.settings.link != blank %}
                              </a>
                           {% endif %}
                          </a>
                      	</h2>
					  {% endif %}
					  {% if block.settings.cta_description != blank %}
                      	<p>{{ block.settings.cta_description }}</p>
					  {% endif %}
					  {% if block.settings.button_text != blank %}
						{% if block.settings.link != blank %}
                              <a href="{{ block.settings.link }}">
                        {% endif %}
                        <div class="r-linkcta href-js margin-top" data-href="https://www.dcshoes.com/josh-kalis-collection/#?intcmp=dc_542092">
                          {{ block.settings.button_text }}
                        </div>
                        {% if block.settings.link != blank %}
                        	</a>
                       	{% endif %}
					  {% endif %}
                    </div>
                    {% if block.settings.link != blank %}
                      </a>
                   {% endif %}
              </div>
           {% endfor %}
        </div>
        <span class="slideshow__arrow slideshow__arrow-right side-arrow side-arrow-right square">
          {% include 'icon-chevron-right-alt' %}
        </span>
      </div>
    </div>
  </article>
</div>

{% javascript %}
	
  function initSlider() {
    var $sliderSelector = $('.slider-thebox');
    var $sliderContainer = $sliderSelector.closest('.slideshow-wrapper');

	if (!$sliderSelector.length) {
		return false;	
	}

    /* Slider settings */
    var settings = {
      accessibility: true,
      arrows: false,
      dots: false,
      fade: true,
      draggable: true,
      touchThreshold: 20,
      centerMode: true,
      centerPadding: '40px',
      slidesToShow: 1,
      mobileFirst: true,
      responsive: [{
        breakpoint: 767,
        settings: "unslick"
      }]
    }

    // data options
    settings.autoplay = $sliderSelector.data('autorotate');
    settings.autoplaySpeed = $sliderSelector.data('speed');

    var adaptHeight = $sliderSelector.data('adapt-height');
    var minAspectRatio = $sliderSelector.data('min-aspect-ratio');
    var sideArrows = $sliderSelector.data('side-arrows');

    if (adaptHeight) {
      $sliderSelector.height($(document).width() / minAspectRatio);
      $(window).resize($.debounce(50, function() {
        $sliderSelector.height($(document).width() / minAspectRatio);
      }));
    }

    var slider = $sliderSelector.slick(settings);

    var $prevArrow = $sliderContainer.find('.side-arrow.side-arrow-left')
    var $nextArrow = $sliderContainer.find('.side-arrow.side-arrow-right')

    if (sideArrows && $sliderSelector.hasClass('slick-initialized')) {
      if ($prevArrow && $prevArrow.length) {
        $prevArrow.on('click', function() {
          $sliderSelector.slick('slickPrev');
        });
      }
      if ($nextArrow && $nextArrow.length) {
        $nextArrow.on('click', function() {
          $sliderSelector.slick('slickNext');
        });
      }
    }

    /* Do this every time window gets resized */
    $(window).on('resize', function() {
      if ($(window).width() < 767) {
      /* We are below mobile breakpoint, initialize the slider
        if it is not already initialized */
      if (!slider.hasClass('slick-initialized')){
          return slider.slick(settings);
        }
      }
    })
  }
                                  
  initSlider();


{% endjavascript %}

