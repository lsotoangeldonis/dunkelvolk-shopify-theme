<script>
 function defer(method, validation) {
    if (validation()) {
      method();
    } else {
      setTimeout(function() { defer(method, validation) }, 50);
    }
 }
</script>
{% if cart.attributes.shipping_method == 'store_pickup' or cart.attributes.store_pickup != blank %}
  <script>
      defer(function(){
        $.ajax({
          type: 'POST',
          url: '/cart/update.js',
          data: 'attributes[store_pickup]=&attributes[shipping_method]=delivery&attributes[free_shipping]=&attributes[free_shipping_min_amount]=',
          dataType: 'json'
        });
      }, function() { return window.jQuery })
  </script>
{% endif %}

