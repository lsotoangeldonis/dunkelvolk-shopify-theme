<script>
  function setLastVisitedCollectionActionBtn() {
    const btn = document.getElementById('lastVisitedCollBtn')
    let href = (document.referrer && document.referrer.indexOf(location.protocol + "//" + location.host) === 0) ? document.referrer : '/'
    if (typeof Storage !== 'undefined' && localStorage.tbx_lastVisitedCollection) {
       href = localStorage.tbx_lastVisitedCollection
    }
    btn.setAttribute('href', href)
  }

  document.addEventListener('DOMContentLoaded', () => {
    setLastVisitedCollectionActionBtn()
  })
</script>

<script>
defer(function(){
  
  $(window).on('load', function (e) {
    var discountsCombineScript = $('script[src="https://thanhhd.com/app/public/discounts-combine/discounts-combine.js?shop=the-box-peru-sac.myshopify.com&shop=the-box-peru-sac.myshopify.com"]')
	
    if (discountsCombineScript.length) {
      defer(function(){
        var $cartSubmitButton = $('#AddressFormComponent_cart_address_form .submit')
        var $loadingIcon = $cartSubmitButton.find('.loader')
        var $discountButton = $('.dcCheckout')

        $discountButton.append($loadingIcon.clone(true, true))

        $discountButton.on('click', function(event) {
            event.stopPropagation()
            event.preventDefault(); 
            $discountButton.addClass('loading')
            $cartSubmitButton.click()
        })
      }, function() { return $('.dcCheckout') && $('.dcCheckout').length })
    }
  })

}, function() { return window.jQuery })
</script>


