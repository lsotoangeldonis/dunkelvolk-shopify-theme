  /* ===== Dunk Header v2 ===== */
  .dunk-header-active > header.site-header { padding: 0 !important; margin: 0 !important; border: 0 !important; min-height: 0 !important; position: relative !important; }
  .dunk-header-active > header.site-header > .site-header__mobile-nav { display: none !important; }
  .dunk-header-active > header.site-header .mobile-search-bar { display: none !important; }
  /* Neutralize the legacy h1 logo so SEO sees it but it doesn't paint */
  .dunk-header-active > header.site-header .site-header__logo {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
  /* Always black text — overlay just removes background, keeps color */
  .dunk-header-wrapper {
    position: relative;
    z-index: 9999;
    background: #fff;
    color: #111;
    transition: background .25s ease;
  }
  .dunk-header-wrapper--overlay {
    position: absolute;
    top: 0; left: 0; right: 0;
    background: transparent;
    color: #111; /* keep black even on overlay */
  }
  .dunk-header-wrapper--solid {
    position: fixed;
    top: 0; left: 0; right: 0;
    background: #fff;
    color: #111;
    box-shadow: 0 1px 0 rgba(0,0,0,.08);
    animation: dunkSlideDown .25s ease;
  }
  @keyframes dunkSlideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  .dunk-utility-row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 56px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #111;
  }
  .dunk-utility-row__center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .dunk-utility-row a { color: inherit; text-decoration: none; }
  .dunk-pill {
    display: inline-block;
    padding: 6px 64px;
    min-width: 360px;
    background: #000;
    color: #fff !important;
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 749px) {
    .dunk-pill { min-width: 0; padding: 8px 36px; font-size: 11px; }
  }

  .dunk-header {
    display: flex !important;
    align-items: center;
    padding: 10px 48px;
    background: transparent;
    color: #111;
    border: 0;
    position: relative;
    gap: 0;
  }
  .dunk-header__farleft { display: none !important; }
  .dunk-header__nav {
    display: flex !important;
    align-items: center;
    gap: 22px;
    flex: 1 1 0;
    min-width: 0;
  }
  .dunk-header__nav--left { justify-content: flex-start; }
  .dunk-header__nav--right { justify-content: flex-end; margin-right: 28px; }
  .dunk-header__nav a {
    color: #111;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 4px 0;
    white-space: nowrap;
  }
  /* Logo stays centered visually because the two nav columns are flex:1 equal */
  .dunk-header__logo { flex: 0 0 auto; margin: 0 28px; }

  /* Icons: never compress, always at the very end */
  .dunk-header__icons {
    flex: 0 0 auto !important;
    min-width: max-content;
  }

  /* Standard laptops 1281-1440 */
  @media (min-width: 1281px) and (max-width: 1440px) {
    .dunk-header { padding: 10px 32px; }
    .dunk-header__nav { gap: 18px; }
    .dunk-header__nav a { font-size: 12px; }
    .dunk-header__logo { margin: 0 20px; }
    .dunk-header__logo img { max-height: 80px; }
    .dunk-header__nav--right { margin-right: 20px; }
  }
  /* Mid-size laptops 750-1280 */
  @media (min-width: 750px) and (max-width: 1280px) {
    .dunk-header { padding: 10px 20px; }
    .dunk-header__nav { gap: 12px; }
    .dunk-header__nav a { font-size: 12px; }
    .dunk-header__icons { gap: 10px; }
    .dunk-header__logo { margin: 0 16px; }
    .dunk-header__logo img { max-height: 64px; }
    .dunk-header__nav--right { margin-right: 14px; }
    .dunk-utility-row { padding: 16px 20px; }
  }
  /* Small laptops 750-1100 */
  @media (min-width: 750px) and (max-width: 1100px) {
    .dunk-header__nav a { font-size: 11px; }
    .dunk-header__nav { gap: 8px; }
    .dunk-header__logo img { max-height: 52px; }
    .dunk-header { padding: 10px 14px; }
    .dunk-header__logo { margin: 0 12px; }
    .dunk-header__nav--right { margin-right: 10px; }
  }
  .dunk-header__nav a:hover { opacity: .7; }
  .dunk-header__logo { display: inline-flex; align-items: center; }
  .dunk-header__logo img { display: block; max-height: 96px; width: auto; }
  .dunk-header__logo-mobile { display: none; }
  .dunk-header__icons {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .dunk-header__icons a,
  .dunk-header__icons button {
    color: #111 !important;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    position: relative;
  }
  .dunk-header__icons svg { fill: #111 !important; width: 18px; height: 18px; }
  .dunk-header__icons .dunk-header__cart-icon {
    display: block;
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
  .dunk-header__icons .dunk-header__cart-link { line-height: 0; }
  .dunk-header__burger {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .dunk-header__burger svg { width: 22px; height: 22px; fill: currentColor; }
  .dunk-header__burger .icon-close { display: none !important; }
  .mobile-nav-open .dunk-header__burger .icon-hamburger { display: none !important; }
  .mobile-nav-open .dunk-header__burger .icon-close { display: inline-block !important; }
  body.mobile-nav-open { overflow: hidden !important; }

  .dunk-header__cart-count {
    position: absolute;
    top: -6px;
    right: -10px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }
  .dunk-header-wrapper--overlay .dunk-header__cart-count {
    background: var(--dunk-overlay-text, #fff);
    color: #000;
  }

  @media (max-width: 749px) {
    /* Overlay becomes relative on mobile so the nav drawer flows below the header */
    .dunk-header-wrapper--overlay { position: relative; }
    /* Push the mobile nav below the Dunk header using the measured height */
    .dunk-header-active .mobile-nav-wrapper {
      top: var(--dunk-header-height, 144px) !important;
      position: fixed !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      overflow-y: auto !important;
    }
    .dunk-header-active .mobile-nav-wrapper.js-menu--is-open {
      display: block !important;
    }
    /* Burger: always visible on mobile; switch to X when nav is open */
    .dunk-header__burger { display: flex !important; }
    .dunk-utility-row {
      padding: 16px 16px;
      justify-content: center;
    }
    .dunk-utility-row__left,
    .dunk-utility-row__right { display: none; }
    .dunk-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px;
      position: relative;
      min-height: 72px;
    }
    .dunk-header__nav--desktop { display: none !important; }
    .dunk-header__logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
    .dunk-header__logo img.dunk-header__logo-desktop,
    .dunk-header__logo span.dunk-header__logo-desktop { display: none !important; }
    .dunk-header__logo-mobile { display: block !important; max-height: 52px; width: auto; }
    .dunk-header__icons svg { width: 18px; height: 18px; }
  }
  @media (min-width: 750px) {
    .dunk-header__burger { display: none !important; }
    .dunk-header__logo-mobile { display: none !important; }
    .dunk-header__icons {
      position: absolute;
      right: 56px;
      top: 50%;
      transform: translateY(-50%);
    }
  }
</style>

