{%- assign dunk_header = section.settings.enable_dunk_header -%}
{%- assign overlay_active = false -%}
{%- if dunk_header and section.settings.transparent_on_index and request.page_type == 'index' -%}
  {%- assign overlay_active = true -%}
{%- endif -%}
{%- assign show_pill = false -%}
{%- if section.settings.message and section.settings.message_text != blank -%}
  {%- if section.settings.home_page_only == false or request.page_type == 'index' -%}
    {%- assign show_pill = true -%}
  {%- endif -%}
{%- endif -%}

<div data-section-id="{{ section.id }}" data-section-type="header-section" data-header-section{% if dunk_header %} class="dunk-header-active"{% endif %}>

{%- if dunk_header -%}
  <div class="dunk-header-wrapper{% if overlay_active %} dunk-header-wrapper--overlay{% endif %}"
       data-dunk-header
       data-overlay="{{ overlay_active }}"
       style="--dunk-overlay-text: {{ section.settings.transparent_text_color | default: '#ffffff' }};">

    {%- if section.settings.utility_left_text != blank or section.settings.utility_right_text != blank or show_pill -%}
      <div class="dunk-utility-row">
        <div class="dunk-utility-row__left">
          {%- if section.settings.utility_left_text != blank -%}
            {%- if section.settings.utility_left_link != blank -%}
              <a href="{{ section.settings.utility_left_link }}">{{ section.settings.utility_left_text | escape }}</a>
            {%- else -%}
              {{ section.settings.utility_left_text | escape }}
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="dunk-utility-row__center">
          {%- if show_pill -%}
            {%- assign pill_bg = section.settings.color_bg | default: '#000000' -%}
            {%- assign pill_color = section.settings.color_text | default: '#ffffff' -%}
            {%- if section.settings.message_link != blank -%}
              <a class="dunk-pill" href="{{ section.settings.message_link }}" style="background: {{ pill_bg }}; color: {{ pill_color }};">{{ section.settings.message_text | escape }}</a>
            {%- else -%}
              <span class="dunk-pill" style="background: {{ pill_bg }}; color: {{ pill_color }};">{{ section.settings.message_text | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="dunk-utility-row__right">
          {%- if section.settings.utility_right_text != blank -%}
            {%- if section.settings.utility_right_link != blank -%}
              <a href="{{ section.settings.utility_right_link }}">{{ section.settings.utility_right_text | escape }}</a>
            {%- else -%}
              {{ section.settings.utility_right_text | escape }}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="dunk-header" role="banner">
      {%- comment -%} Far left: Tiendas (single link) · mobile burger {%- endcomment -%}
      <div class="dunk-header__farleft dunk-header__nav--desktop">
        {%- if section.settings.farleft_text != blank -%}
          {%- if section.settings.farleft_link != blank -%}
            <a href="{{ section.settings.farleft_link }}">{{ section.settings.farleft_text | escape }}</a>
          {%- else -%}
            {{ section.settings.farleft_text | escape }}
          {%- endif -%}
        {%- endif -%}
      </div>
      <button type="button" class="dunk-header__burger js-mobile-nav-toggle mobile-nav--open"
              aria-controls="MobileNav" aria-expanded="false"
              aria-label="{{ 'layout.navigation.menu' | t }}">
        {% include 'icon-hamburger' %}
        {% include 'icon-close' %}
      </button>

      {%- comment -%} Left of logo: main nav (Ropa Calzado Accesorios) {%- endcomment -%}
      <div class="dunk-header__nav dunk-header__nav--left dunk-header__nav--desktop">
        {%- assign dunk_left_list = section.settings.dunk_left_linklist -%}
        {%- if dunk_left_list == blank -%}{%- assign dunk_left_list = section.settings.main_linklist -%}{%- endif -%}
        {%- if linklists[dunk_left_list].links.size > 0 -%}
          {%- for link in linklists[dunk_left_list].links -%}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} Center: logo (h1 stays on the legacy header for SEO) {%- endcomment -%}
      <div class="dunk-header__logo">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            <img class="dunk-header__logo-desktop"
                 src="{{ section.settings.logo | img_url: '500x' }}"
                 srcset="{{ section.settings.logo | img_url: '500x' }} 1x, {{ section.settings.logo | img_url: '1000x' }} 2x"
                 alt="{{ section.settings.logo.alt | default: shop.name | escape }}">
          {%- else -%}
            <span class="dunk-header__logo-desktop">{{ shop.name }}</span>
          {%- endif -%}
          {%- if section.settings.logo_mobile_filename != blank -%}
            <img class="dunk-header__logo-mobile"
                 src="{{ section.settings.logo_mobile_filename | asset_url }}"
                 alt="{{ shop.name | escape }}"
                 loading="eager">
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} Right of logo: secondary nav (About Us · The Pima Journey · Explorer's Club) {%- endcomment -%}
      <div class="dunk-header__nav dunk-header__nav--right dunk-header__nav--desktop">
        {%- if linklists[section.settings.secondary_linklist].links.size > 0 -%}
          {%- for link in linklists[section.settings.secondary_linklist].links -%}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} Far right: icons (search, account, cart) {%- endcomment -%}
      <div class="dunk-header__icons">
        <button type="button" class="js-drawer-open-top" aria-label="{{ 'general.search.submit' | t }}">
          {% include 'icon-search' %}
        </button>
        {%- if shop.customer_accounts_enabled -%}
          {%- if customer -%}
            <a href="{{ routes.account_url }}" aria-label="{{ 'layout.customer.account' | t }}">
              {% include 'icon-login' %}
            </a>
          {%- else -%}
            <a href="{{ routes.account_login_url }}" aria-label="{{ 'layout.customer.log_in' | t }}">
              {% include 'icon-login' %}
            </a>
          {%- endif -%}
        {%- endif -%}
        <a href="{{ routes.cart_url }}" aria-label="{{ 'layout.cart.title' | t }}" class="dunk-header__cart-link">
          <img class="dunk-header__cart-icon" src="{{ 'backpack.png' | asset_url }}" alt="" width="22" height="22" loading="eager">
          <span id="DunkCartCount" class="dunk-header__cart-count{% if cart.item_count == 0 %} hide{% endif %}" data-cart-count-bubble>
            <span data-cart-count>{{ cart.item_count }}</span>
          </span>
        </a>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var wrapper = document.querySelector('[data-dunk-header]');
      if (!wrapper) return;
      var isOverlay = wrapper.getAttribute('data-overlay') === 'true';
      var threshold = 60;
      var lastSolid = null;
      function onScroll() {
        var solid = window.scrollY > threshold;
        if (solid === lastSolid) return;
        lastSolid = solid;
        // Always remove overlay class when scrolled (so solid bg can take over);
        // restore overlay when back at top
        if (isOverlay) {
          if (solid) {
            wrapper.classList.remove('dunk-header-wrapper--overlay');
          } else {
            wrapper.classList.add('dunk-header-wrapper--overlay');
          }
        }
        wrapper.classList.toggle('dunk-header-wrapper--solid', solid);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Expose header height as CSS variable for mobile nav offset
      function setNavOffset() {
        var wrapperEl = document.querySelector('.dunk-header-wrapper');
        if (wrapperEl) {
          document.documentElement.style.setProperty('--dunk-header-height', wrapperEl.offsetHeight + 'px');
        }
      }
      setNavOffset();
      window.addEventListener('resize', setNavOffset, { passive: true });
    })();
  </script>
{%- endif -%}


  <header class="site-header{% if section.settings.align_logo == 'left' %} border-bottom logo--left{% else %} logo--center{% endif %}" role="banner">
    
