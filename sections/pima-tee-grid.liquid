{%- assign component_class = 'pima-tee-grid__' | append: section.id -%}

<style>
  .{{ component_class }} {
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .{{ component_class }}__inner {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 56px;
    box-sizing: border-box;
  }
  .{{ component_class }}__title-wrap {
    border-top: 1px solid #111;
    padding-top: 12px;
    margin: 0 0 28px;
    text-align: left;
  }
  .{{ component_class }}__title {
    font-family: var(--font-body, inherit) !important;
    font-weight: 800;
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.15;
    margin: 0;
    color: inherit;
  }
  .{{ component_class }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  .{{ component_class }}__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .{{ component_class }}__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f4f4f4;
    margin-bottom: 18px;
  }
  .{{ component_class }}__media img,
  .{{ component_class }}__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .{{ component_class }}__cta {
    display: inline-block;
    padding: 4px 28px;
    border: 1px solid #111;
    border-radius: 6px;
    background: transparent;
    color: #111;
    font-family: var(--font-body, inherit);
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }
  .{{ component_class }}__cta:hover {
    background: #111;
    color: #fff;
  }
  @media (max-width: 749px) {
    .{{ component_class }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    .{{ component_class }}__inner { padding: 0 24px; }
    .{{ component_class }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
      gap: 14px;
    }
    .{{ component_class }}__title { font-size: 20px; }
    .{{ component_class }}__media { margin-bottom: 12px; }
    .{{ component_class }}__cta { padding: 5px 18px; font-size: 11px; }

    /* intercalación: intercambia el orden visual de cada 2º par de cards */
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(1) { order: 1; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(2) { order: 2; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(3) { order: 4; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(4) { order: 3; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(5) { order: 5; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(6) { order: 6; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(7) { order: 8; }
    .{{ component_class }}--intercalate .{{ component_class }}__card:nth-child(8) { order: 7; }
  }
</style>

{%- assign intercalate_class = '' -%}
{%- if section.settings.intercalate_mobile -%}
  {%- assign intercalate_class = ' ' | append: component_class | append: '--intercalate' -%}
{%- endif -%}
<section class="{{ component_class }}{{ intercalate_class }}" data-section-id="{{ section.id }}" data-section-type="pima-tee-grid">
  <div class="{{ component_class }}__inner">
    {%- if section.settings.title != blank -%}
      <div class="{{ component_class }}__title-wrap">
        <h2 class="{{ component_class }}__title">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="{{ component_class }}__grid">
        {%- for block in section.blocks -%}
          {%- assign desktop_img = block.settings.image -%}
          {%- assign mobile_img = block.settings.image_mobile | default: desktop_img -%}
          {%- assign asset_src = '' -%}
          {%- if block.settings.asset_filename != blank -%}
            {%- assign asset_src = block.settings.asset_filename | asset_url -%}
          {%- endif -%}
          <div class="{{ component_class }}__card" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="{{ component_class }}__media" href="{{ block.settings.link }}" aria-label="{{ block.settings.button_label | default: 'Shop Now' | escape }}">
            {%- else -%}
              <div class="{{ component_class }}__media">
            {%- endif -%}
              {%- if asset_src != '' -%}
                <img src="{{ asset_src }}" alt="{{ block.settings.button_label | default: 'Shop Now' | escape }}" loading="lazy">
              {%- elsif desktop_img != blank -%}
                <picture>
                  <source media="(min-width: 750px)" srcset="{{ desktop_img | img_url: '600x' }} 1x, {{ desktop_img | img_url: '1200x' }} 2x">
                  <source media="(max-width: 749px)" srcset="{{ mobile_img | img_url: '600x' }} 1x, {{ mobile_img | img_url: '1200x' }} 2x">
                  <img src="{{ desktop_img | img_url: '800x' }}" alt="{{ desktop_img.alt | default: block.settings.button_label | escape }}" loading="lazy">
                </picture>
              {%- else -%}
                {%- capture placeholder_index -%}{% cycle '1','2','3','4','5','6' %}{%- endcapture -%}
                {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              {%- assign cta_href = block.settings.link | default: '#' -%}
              <a href="{{ cta_href }}" class="{{ component_class }}__cta">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": {
    "en": "Pima Tee grid",
    "es": "Pima Tee grid"
  },
  "class": "index-section pima-tee-grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": { "en": "Title", "es": "Título" },
      "default": "The Pima Tee: La prenda con más confort"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2, "max": 6, "step": 1,
      "label": { "en": "Columns (desktop)", "es": "Columnas (desktop)" },
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1, "max": 3, "step": 1,
      "label": { "en": "Columns (mobile)", "es": "Columnas (mobile)" },
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "intercalate_mobile",
      "label": { "en": "Intercalate pairs on mobile", "es": "Intercalar pares en mobile" },
      "info": { "en": "Swaps the visual order of every 2nd pair of cards on mobile (e.g. rows 1+2 keep order, rows 3+4 swap).", "es": "Invierte el orden visual de cada 2° par de tarjetas en mobile." },
      "default": false
    },
    {
      "type": "header",
      "content": { "en": "Style", "es": "Estilo" }
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": { "en": "Background color", "es": "Color de fondo" },
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": { "en": "Text color", "es": "Color del texto" },
      "default": "#111111"
    },
    {
      "type": "header",
      "content": { "en": "Spacing", "es": "Espaciado" }
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": { "en": "Top padding (desktop)", "es": "Padding superior (desktop)" },
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": { "en": "Bottom padding (desktop)", "es": "Padding inferior (desktop)" },
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": { "en": "Top padding (mobile)", "es": "Padding superior (mobile)" },
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": { "en": "Bottom padding (mobile)", "es": "Padding inferior (mobile)" },
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": { "en": "Card", "es": "Tarjeta" },
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": { "en": "Image (desktop)", "es": "Imagen (desktop)" }
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": { "en": "Image (mobile)", "es": "Imagen (mobile)" }
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": { "en": "Theme asset filename (overrides Image)", "es": "Nombre del asset (anula Imagen)" },
          "info": { "en": "e.g. dunk-pima-tee-001.jpg — file in /assets/. Takes priority.", "es": "ej. dunk-pima-tee-001.jpg — archivo en /assets/. Tiene prioridad." }
        },
        {
          "type": "url",
          "id": "link",
          "label": { "en": "Link", "es": "Enlace" }
        },
        {
          "type": "text",
          "id": "button_label",
          "label": { "en": "Button label", "es": "Texto del botón" },
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": { "en": "Pima Tee grid", "es": "Pima Tee grid" },
      "category": { "en": "Dunkelvolk", "es": "Dunkelvolk" },
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
