<script>
   function defer(method, validation) {
      if (validation()) {
        method();
      } else {
        setTimeout(function() { defer(method, validation) }, 50);
      }
    }
   
    function scrollToID(id, speed) {
      var offSet = 120;
      var obj = $('[data-scroll-id="'+id+'"]');
      if (obj.length){
        var offs = obj.offset();
        var targetOffset = offs.top - offSet;
        $('html,body').animate({ scrollTop: targetOffset }, speed);
      }
    }
    
    defer(function(){
      $(document).ready(function () {
        var scroll = window.location.hash;
        if (scroll){
          scrollToID(scroll, 1000);
        }
      });
   
      $(document).on('click', 'a[href="#subetuarte"]', function(e) {
        e.preventDefault();
        scrollToID($(this).attr('href'), 1000);
      })
    }, function() { return window.jQuery })
</script>