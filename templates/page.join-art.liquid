                    var $loadingBar = $container.find('.upload-loading-bar');
            
                    if (!validator($form)) {
                        return false;
                    }
            
                    $container.addClass('loading')
                    
                    $loadingBar.css('width', '0%').fadeIn(1000);
                    
                    $loadingBar.find('.percentage').text('0');
            
                    $form.find("select, textarea, input").prop('disabled', true).css('opacity', '0.5');
                    
                    $form.find(':submit').parent().fadeOut(1000)

                    $clonedForm.append('<input class="field" name="entry.2090315892" value="'+ window.location.hostname +'">')

                    var fieldsMap = {
                        "Nombre": 'entry.1101777866',
                        "Apellido": 'entry.715933198',
                        "Email": 'entry.406376883',
                        "DNI": 'entry.1542249188',
                        "Teléfono": 'entry.700385683',
                        //"Fecha": 'entry.1337194923',
                        "Web": 'entry.2090315892',
                    }
            
                    $formFields.each(function(idx){
                        var $field = $(this);
                        var name = $(this).attr('name')
                        if (name === 'Terminos' || name === 'file') {
                            $field.remove()
                            return
                        }
                        $field.attr('name', fieldsMap[name])
                    })                      
            
                    var fData = new FormData($clonedForm[0])
           
                    var $uploadFileInput = $('input.cloudinary_fileupload[type=file]')
                    
                    $uploadFileInput
                      .cloudinary_fileupload()
                      .bind('cloudinaryprogress', function(e, data) {
                        var percentage = Math.round((data.loaded * 100.0) / data.total)
                        $(selector).find('.upload-loading-bar').fadeIn(1000).css('width', percentage + '%').find('.percentage').text(percentage);
                      })
                      .bind('cloudinarydone', function(e, data) {
            	  fData.append("entry.1877698108", removeFileExtension(data.files[0].name)) // Image/Video
            
                        $.ajax({
                            url: 'https://docs.google.com/forms/d/1lA1n4A-sxEUwi7jnYFZOWv0PxgvfEjDuqIi-s70XpFY/formResponse',
                            type: 'POST',
                            dataType: "JSON",
                            data: fData,
                            processData: false,
                            contentType: false,
                            success: function (data, status) {
                              console.log(data)
                            },
                            error: function (xhr, desc, err) {
                              console.log(err)
                            }
                        });
                        
                        var $container = $(selector);
                        var $form = $container.find('form');
                        
                        $container.find('.upload-loading-bar').fadeOut(1000)
                        $container.removeClass('loading')
                        $form[0].reset()
                        $form.find('.formSuccessWrapper').fadeIn(1000)
                      }).change();
                      
                  });
                
                  
             })
              
            	}, function() { return window.jQuery } )
         </script>
