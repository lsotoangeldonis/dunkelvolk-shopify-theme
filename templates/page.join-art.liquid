            function defer(method, validation) {
              if (validation()) {
                method();
              } else {
                setTimeout(function() { defer(method, validation) }, 50);
              }
            }
            
            function fileValidation() { 
              var fileInput =  
                  $('input.cloudinary_fileupload[type=file]')[0]; 
            
              var filePath = fileInput.value;
              
              var acceptFileTypes = /^image\/(gif|jpe?g|tiff?|png|webp|bmp)$/i // /^video\/(mp4|m4v|m4|avi|wmv|mov|qt|flv|ogg|webm|mpg|mp2|mpeg|mpe|mpv)$/i;
              
              if (!fileInput.files || !fileInput.files.length) {
            return { error: true, message: 'Debes escoger un archivo de imagen.' }
              }
              
              console.log(fileInput.files[0]['type'], acceptFileTypes.test(fileInput.files[0]['type'], fileInput.files))
              
              if(fileInput.files[0]['type'].length && !acceptFileTypes.test(fileInput.files[0]['type'])) {
                return { error: true, message: 'El tipo de archivo no está soportado.' }
              }
              
              if (fileInput.files[0]['size'].length && fileInput.files[0]['size'] && (fileInput.files[0]['size'] / (1024*1024)) > 9) {
                return { error: true, message: 'El archivo es muy pesado.' }
              }
              
              return { error: false, message: null }
              
            }
            
            function fileExtension(str) {
              const re = /(?:\.([^.]+))?$/
                return re.exec(str)[1]
            }
            
            function removeFileExtension(str) {
              return str.replace(/\.[^/.]+$/, '')
            }
            
