                    }
            
                    $formFields.each(function(idx){
                        var $field = $(this);
                        var name = $(this).attr('name')
                        if (name === 'Terminos' || name === 'file') {
                            $field.remove()
                            return
                        }
                        $field.attr('name', fieldsMap[name])
                    })                      
            
                    var fData = new FormData($clonedForm[0])
                    
                    var $container = $(selector);
                    var $form = $container.find('form');
                    
                    
                    $container.find('.upload-loading-bar').fadeOut(1000)
                    $container.removeClass('loading')
                              
                    var $uploadFileInput = $('input.cloudinary_fileupload[type=file]')

                    var clFData = $uploadFileInput.attr('data-form-data') && JSON.parse($uploadFileInput.attr('data-form-data'))
                    var DNI = $form.find('[name="DNI"]').val()
                    
                    clFData.tags = [`CODIGO_DNI:${DNI}`]

                    $uploadFileInput.attr('data-form-data', JSON.stringify(clFData))
                    
                    $uploadFileInput
                      .cloudinary_fileupload()
                      .bind('cloudinaryprogress', function(e, data) {
                        var percentage = Math.round((data.loaded * 100.0) / data.total)
                        $(selector).find('.upload-loading-bar').fadeIn(1000).css('width', percentage + '%').find('.percentage').text(percentage);
                      })
                      .bind('cloudinarydone', function(e, data) {
            	        fData.append("entry.259675060", getFileExtension(data.files[0].name)) // Image/Video
            	        fData.append("entry.1877698108", data.files[0].name) // Image/Video
            	        fData.append("entry.1533755785", data.result.url) // Image/Video
            
                    $.ajax({
                        url: 'https://docs.google.com/forms/u/0/d/e/1FAIpQLScq307YLX4t6D5wgyf4a2gDw_3hN84cXbPnqzkmhUr2GzOLNw/formResponse',
                        type: 'POST',
                        dataType: "JSON",
                        data: fData,
                        processData: false,
                        contentType: false,
                        success: function (data, status) {
                          console.log(data)
                        },
                        error: function (xhr, desc, err) {
                          console.log(err)
                        }
                    });
                        
                        var $container = $(selector);
                        var $form = $container.find('form');
                        
                        $container.find('.upload-loading-bar').fadeOut(1000)
                        $container.removeClass('loading')
                        $form[0].reset()
                        $form.find('.formSuccessWrapper').fadeIn(1000)
                      }).bind('cloudinaryerror', function(e, data) {
                        console.log('Error al cargar el archivo a Cloudinary:', data);
                        // Aquí puedes manejar el error de la carga de alguna manera
                      }).change();
                      
                  });
                
                  
             })
              
            	}, function() { return window.jQuery } )
         </script>
